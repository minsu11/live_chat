# Docker infrastructure
PERF_DB_PORT=3307
PERF_DB_NAME=chat_server_perf
PERF_DB_PASSWORD=1234
PERF_REDIS_PORT=6380
PERF_PROMETHEUS_PORT=9091
PERF_GRAFANA_PORT=3001

# Spring Boot perf profile
PERF_DB_POOL_MAX=10
PERF_DB_POOL_MIN=10
PERF_DB_CONNECTION_TIMEOUT_MS=3000
CHAT_METADATA_FLUSH_DELAY_MS=10000

# k6 load scenario
# ROOM_ID=1
# ACCESS_TOKEN=<JWT without Bearer prefix>
# USER_ID=1
# Multiple credentials can be comma-separated.
# ACCESS_TOKENS=<token1>,<token2>
# USER_IDS=1,2
# WS_BASE_URL=ws://host.docker.internal:7070
